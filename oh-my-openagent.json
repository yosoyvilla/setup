        }
      ]
    },
    "unspecified-low": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
          "model": "nan/glm5.3-flash-low"
        }
      ]
    },
    "unspecified-high": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
