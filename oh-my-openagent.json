          "model": "nan/glm5.3-flash-low"
        }
      ]
    },
    "deep": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
          "model": "nan/glm5.3-flash-low"
        }
      ]
    },
    "artistry": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
          "model": "nan/glm5.3-flash-low"
        }
      ]
    }
  },
  "hashline_edit": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 15,
    "timeout_seconds": 10,
    "notify_on_fallback": true
  },
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true,
    "dynamic_context_pruning": {
      "enabled": true,
      "notification": "minimal",
      "turn_protection": {
        "enabled": true,
        "turns": 3
      },
      "strategies": {
        "deduplication": {
          "enabled": true
        },
        "supersede_writes": {
          "enabled": true,
          "aggressive": false
        },
        "purge_errors": {
          "enabled": true,
          "turns": 5
        }
      }
    }
  },
  "background_task": {
    "defaultConcurrency": 4,
    "providerConcurrency": {
      "nan": 6,
      "anthropic": 1
    }
  }
}
