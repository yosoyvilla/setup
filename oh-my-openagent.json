        }
      ]
    },
    "sisyphus-junior": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
          "model": "nan/glm5.3-flash-low"
        }
      ]
    }
  },
  "categories": {
    "quick": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
