        }
      ]
    },
    "writing": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
          "model": "nan/glm5.3-flash-low"
        }
      ]
    },
    "visual-engineering": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
        {
          "model": "nan/glm5.3-flash-low"
        }
      ]
    },
    "ultrabrain": {
      "model": "nan/deepseek-v4-flash-low",
      "fallback_models": [
